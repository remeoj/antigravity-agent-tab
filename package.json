{
  "name": "antigravity-agent-tab",
  "displayName": "Antigravity Agent Floating Window",
  "description": "Press Cmd+Shift+A (or click the status bar button) to detach the Antigravity Agent side panel into a separate floating window, or reattach it back into the side panel.",
  "version": "1.1.6",
  "publisher": "joemerramos",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/remeoj/antigravity-agent-tab.git"
  },
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "keywords": [
    "antigravity",
    "agent",
    "floating window",
    "detach",
    "side panel"
  ],
  "activationEvents": [
    "*",
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "scripts": {
    "test": "ELECTRON_RUN_AS_NODE=1 \"/Applications/Antigravity IDE.app/Contents/MacOS/Electron\" ./test/integration.test.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "antigravityTab.toggleFloatingWindow",
        "title": "Toggle Agent Floating Window / Side Panel",
        "category": "Antigravity",
        "icon": "$(link-external)"
      },
      {
        "command": "antigravityTab.detachToFloatingWindow",
        "title": "Detach Agent Side Panel to Floating Window",
        "category": "Antigravity",
        "icon": "$(link-external)"
      },
      {
        "command": "antigravityTab.reattachToSidePanel",
        "title": "Reattach Agent Window to Side Panel",
        "category": "Antigravity",
        "icon": "$(layout-sidebar-right)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "antigravityAgentTabSidebar",
          "title": "Antigravity Floating Window",
          "icon": "media/activity-bar.svg"
        }
      ]
    },
    "views": {
      "antigravityAgentTabSidebar": [
        {
          "type": "webview",
          "id": "antigravityTab.sidebarView",
          "name": "Agent Floating Window"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "antigravityTab.sidebarView",
        "contents": "Detach the Antigravity Agent side panel into a standalone floating window, or reattach it back to the side panel.\n[Detach / Reattach Agent (Cmd+Shift+A)](command:antigravityTab.toggleFloatingWindow)\n[Detach to Floating Window](command:antigravityTab.detachToFloatingWindow)\n[Reattach to Side Panel](command:antigravityTab.reattachToSidePanel)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "antigravityTab.detachToFloatingWindow",
          "when": "view == antigravityTab.sidebarView && !antigravityTab.isDetached",
          "group": "navigation@1"
        },
        {
          "command": "antigravityTab.reattachToSidePanel",
          "when": "view == antigravityTab.sidebarView && antigravityTab.isDetached",
          "group": "navigation@1"
        }
      ],
      "editor/title": [
        {
          "command": "antigravityTab.detachToFloatingWindow",
          "when": "!antigravityTab.isDetached",
          "group": "navigation@99"
        },
        {
          "command": "antigravityTab.reattachToSidePanel",
          "when": "antigravityTab.isDetached",
          "group": "navigation@99"
        }
      ]
    },
    "keybindings": [
      {
        "command": "antigravityTab.toggleFloatingWindow",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a"
      }
    ]
  }
}
